# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Как часто повторять поиск (в минутах, минимум 5)
SEARCH_INTERVAL_MINUTES=20

# Сколько новых мероприятий отправлять за один цикл
MAX_EVENTS_PER_CYCLE=6

# Сколько результатов брать с каждой поисковой выдачи
SEARCH_RESULTS_PER_QUERY=10

# Максимум страниц для проверки за один поиск
SEARCH_MAX_URLS=30

# Максимум мероприятий, которые проходят фильтры за один поиск
SEARCH_MAX_EVENTS=50

# Где хранить состояние (по умолчанию data/users.json)
# DATA_FILE=data/users.json

# User-Agent для HTTP-запросов (обычно менять не нужно)
# USER_AGENT=Mozilla/5.0 ...
